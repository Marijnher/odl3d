# Simple textured unit cube, centered on the origin, used as a reference .obj for odl3d.
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# front (+Z)
f 1/1 2/2 3/3 4/4
# back (-Z)
f 6/1 5/2 8/3 7/4
# left (-X)
f 5/1 1/2 4/3 8/4
# right (+X)
f 2/1 6/2 7/3 3/4
# top (+Y)
f 4/1 3/2 7/3 8/4
# bottom (-Y)
f 5/1 6/2 2/3 1/4

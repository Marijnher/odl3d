    <effect id="kage_out_1_1-fx" name="kage_out_1_1">
      <profile_COMMON>
        <newparam sid="kage_out_1_1-diffuse-surface">
          <surface type="2D">
            <init_from>kage_out_1_1-diffuse-image</init_from>

        </newparam>
        <newparam sid="kage_out_1_1-diffuse-sampler">
          <sampler2D>
            <source>kage_out_1_1-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>

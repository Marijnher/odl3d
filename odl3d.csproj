<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Configurations>Debug;Release</Configurations>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>disable</Nullable>
        <Authors>Marijn Herrebout</Authors>
        <Copyright>Marijn Herrebout</Copyright>
        <RepositoryUrl>https://github.com/Marijnher/odl3d</RepositoryUrl>
        <Nullable>enable</Nullable>
        <!-- Library has no entry point of its own, so a deps.json is never consulted at runtime -->
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <Optimize>False</Optimize>
        <OutputPath>build/Debug</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <Optimize>True</Optimize>
        <OutputPath>build/Release</OutputPath>
        <!-- Library projects don't copy transitive package deps locally by default; needed so Crc32.NET.dll is present to merge -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="demo/**/*.cs;tests/**/*.cs;external/**/*.cs" />
        <ProjectReference Include="external/decodl/decodl.csproj" />
        <InternalsVisibleTo Include="odl3d.Tests.Unit" />
        <InternalsVisibleTo Include="odl3d.Tests.Native" />
    </ItemGroup>

    <ItemGroup>
        <!-- GLFW -->
        <None Include="bin/glfw3.dll" Condition="Exists('bin/glfw3.dll')">
            <Link>bin/glfw3.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="bin/libglfw.3.dylib" Condition="Exists('bin/libglfw.3.dylib')">
            <Link>bin/libglfw.3.dylib</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="bin/libglfw.3.so" Condition="Exists('bin/libglfw.3.so')">
            <Link>bin/libglfw.3.so</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <!-- Freetype -->
        <None Include="bin/freetype.dll" Condition="Exists('bin/freetype.dll')">
            <Link>bin/freetype.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="bin/libfreetype.6.dylib" Condition="Exists('bin/libfreetype.6.dylib')">
            <Link>bin/libfreetype.6.dylib</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="bin/libfreetype.6.so" Condition="Exists('bin/libfreetype.6.so')">
            <Link>bin/libfreetype.6.so</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" PrivateAssets="All" />
    </ItemGroup>

    <!-- Fold decodl and its Crc32.NET dependency into odl3d.dll so Release output is a single assembly -->
    <Target Name="MergeReferencedAssemblies" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
        <ItemGroup>
            <MergeAssemblies Include="$(TargetDir)$(AssemblyName).dll" />
            <MergeAssemblies Include="$(TargetDir)decodl.dll" />
            <MergeAssemblies Include="$(TargetDir)Crc32.NET.dll" />
        </ItemGroup>
        <ILRepack
            Parallel="true"
            Internalize="true"
            InputAssemblies="@(MergeAssemblies)"
            TargetKind="Dll"
            OutputFile="$(TargetDir)$(AssemblyName).dll" />
        <Delete Files="$(TargetDir)decodl.dll;$(TargetDir)decodl.pdb;$(TargetDir)Crc32.NET.dll" />
    </Target>

    <!-- dotnet publish resolves decodl/Crc32.NET straight from their source paths, bypassing the Build-time merge/delete above -->
    <Target Name="ExcludeMergedAssembliesFromPublish" AfterTargets="Publish" Condition="'$(Configuration)'=='Release'">
        <Delete Files="$(PublishDir)decodl.dll;$(PublishDir)decodl.pdb;$(PublishDir)Crc32.NET.dll" />
    </Target>

</Project>

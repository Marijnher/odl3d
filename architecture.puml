@startuml odl3d
title odl3d public API

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #4A5568
skinparam package {
  BackgroundColor #F7FAFC
  BorderColor #718096
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #2D3748
}

package "Application" {
  component "Game loop" as app
}

package "Scene API" {
  component "Window" as window
  component "Camera" as camera
  component "Scene3D" as scene3d
  component "Scene2D" as scene2d
  component "Scene<Object3D>" as scene
}

package "Drawables and resources" {
  component "Object3D" as object3d
  component "Model" as model
  component "Sprite2D / Sprite3D" as sprites
  component "Text2D / Text3D" as text
  component "Mesh" as mesh
  component "Texture" as texture
  component "Sampler" as sampler
  component "ShaderProgram" as shader
  component "Font" as font
  component "ObjectShaderData" as objdata
}

package "Renderer abstraction" as renderer{
  interface "IRenderDevice" as device
  component "RenderFactory" as factory
  component "OpenGLRenderDevice" as opengl
  component "MetalRenderDevice" as metal
  component "VulkanRenderDevice" as vulkan
  component "Direct12RenderDevice" as direct12
}

package "Shaders" as shaders {
  component "GLSL" as glsl
  component "MSL" as msl
}

app --> factory : renderer
app --> window : create / render
window --> camera
window o-- scene : manages

scene3d --|> scene
scene2d --|> scene
scene3d --> camera : view
scene o-- object3d : contains
scene -right-> shaders

model --|> object3d
sprites --|> object3d
text --|> object3d
object3d --> mesh
object3d --> texture
object3d --> shader
object3d --> sampler
object3d --> device
object3d --> objdata
text --> font

factory --> device : active backend
device <|.. opengl
device <|.down. metal
device <|.right. vulkan
device <|.down. direct12

objdata -right-> shaders
device --> shaders

note right of app
  Typical flow:
  create renderer and window
  create scenes and drawables
  add drawables to scenes
  update and render each frame
end note

@enduml
